{
  "name": "binhlaig-ui",
  "version": "0.2.11",
  "description": "Official CLI for initializing and installing Binhlaig UI components",
  "type": "module",
  "bin": {
    "binhlaig-ui": "bin/cli.js"
  },
  "files": [
    "bin",
    "lib",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "start": "node ./bin/cli.js",
    "test": "node test/config.test.js && node test/native.test.js && node test/cli-persistence.test.js && node test/components.test.js && node ./bin/cli.js --help && node ./bin/cli.js list",
    "pack:check": "npm pack --dry-run",
    "prepublishOnly": "npm test"
  },
  "keywords": [
    "binhlaig",
    "binhlaig-ui",
    "ui",
    "cli",
    "react",
    "nextjs",
    "vite",
    "tailwind",
    "components",
    "component-library"
  ],
  "author": "Binhlaig",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sanlinns/binhlaig-ui-cli.git"
  },
  "bugs": {
    "url": "https://github.com/Sanlinns/binhlaig-ui-cli/issues"
  },
  "homepage": "https://github.com/Sanlinns/binhlaig-ui-cli#readme",
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "dependencies": {
    "@inquirer/prompts": "^7.10.1",
    "chalk": "^5.4.1",
    "commander": "^14.0.0",
    "execa": "^9.6.0"
  }
}