{
  "name": "binhlaig-ui",
  "version": "0.2.2",
  "description": "CLI for installing Binhlaig UI components",
  "type": "module",
  "bin": {
    "binhlaig-ui": "bin/cli.js"
  },
  "files": [
    "bin",
    "lib",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "start": "node bin/cli.js",
    "test": "node test/native.test.js && node bin/cli.js --help && node bin/cli.js list",
    "pack:check": "npm pack --dry-run"
  },
  "keywords": [
    "binhlaig",
    "ui",
    "react",
    "nextjs",
    "vite",
    "tailwind",
    "components"
  ],
  "author": "Binhlaig",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sanlinns/binhlaig-ui-cli.git"
  },
  "bugs": {
    "url": "https://github.com/Sanlinns/binhlaig-ui-cli/issues"
  },
  "homepage": "https://github.com/Sanlinns/binhlaig-ui-cli#readme",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@inquirer/prompts": "^7.10.1",
    "chalk": "^5.4.1",
    "commander": "^14.0.0",
    "execa": "^9.6.0"
  }
}
